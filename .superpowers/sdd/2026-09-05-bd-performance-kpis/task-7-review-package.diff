+import type { BdPerformanceResponse, InterviewSummary, LeadSummary, SessionUser, TaskSummary } from "@orbit/contracts";
+import { Card } from "@orbit/ui";
+
+import { BdPeerRanking } from "../performance/bd-peer-ranking";
+import { BdPersonalQuality } from "../performance/bd-personal-quality";
+
+type BdDashboardProps = {
+  actor: SessionUser;
+  applications: LeadSummary[];
+  openTasks: TaskSummary[];
+  interviews: InterviewSummary[];
+  performance?: BdPerformanceResponse;
+  todayPerformance?: BdPerformanceResponse;
+  error?: string;
+};
+
+function interviewTime(interview: InterviewSummary): string {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hour12: false, timeZone: interview.timezone }).format(new Date(interview.startsAt));
+}
+
+export function BdDashboard({ actor, applications, openTasks, interviews, performance, todayPerformance, error }: BdDashboardProps) {
+  const now = new Date();
+  const today = new Intl.DateTimeFormat("en-CA").format(now);
+  const responses = applications.filter((application) => application.status === "RESPONSE_RECEIVED");
+  const active = applications.filter((application) => ["INTERVIEWING", "OFFER_RECEIVED", "OFFER_ACCEPTED", "PLACED"].includes(application.status));
+  const upcoming = interviews.filter((interview) => new Date(interview.startsAt) >= now).sort((left, right) => new Date(left.startsAt).getTime() - new Date(right.startsAt).getTime()).slice(0, 5);
+  const dailyTarget = performance?.currentDailyTarget ?? 70;
+  const qualifiedToday = todayPerformance?.performance.qualifiedApplications ?? applications.filter((application) => application.appliedDate === today).length;
+  const interviewsToSchedule = todayPerformance?.performance.interviewsNeedingScheduling ?? responses.length;
+  const kpis = [
+    ["Qualified applications today", qualifiedToday, "bg-primary-soft", "text-primary", "/leads"],
+    ["Remaining target", Math.max(0, dailyTarget - qualifiedToday), "bg-warning-soft", "text-warning-foreground", "/leads"],
+    ["Recruiter responses", todayPerformance?.performance.recruiterResponses ?? responses.length, "bg-info-soft", "text-info", "/leads?status=RESPONSE_RECEIVED"],
+    ["Interviews to schedule", interviewsToSchedule, "bg-danger-soft", "text-danger", "/leads?status=RESPONSE_RECEIVED"],
+  ] as const;
+  const platformCounts = new Map<string, number>();
+  applications.forEach((application) => { try { const host = new URL(application.rawUrl).hostname.replace(/^www\./, ""); platformCounts.set(host, (platformCounts.get(host) ?? 0) + 1); } catch { platformCounts.set("Other", (platformCounts.get("Other") ?? 0) + 1); } });
+  return <div aria-label="BD application workspace" className="editorial-dashboard mx-auto max-w-[1500px]">
