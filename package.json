{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@orbit/web",
    "dev:api": "turbo run dev --filter=@orbit/api",
    "dev:worker": "turbo run dev --filter=@orbit/worker",
    "build": "turbo run build",
    "format:check": "git diff --check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm test:e2e:services && pnpm test:e2e:smoke",
    "test:e2e:services": "turbo run test:e2e --filter=@orbit/api --filter=@orbit/worker",
    "test:e2e:smoke": "turbo run test:e2e --filter=@orbit/web",
    "db:generate": "packages/database/node_modules/.bin/prisma generate --schema packages/database/prisma/schema.prisma",
    "db:validate": "packages/database/node_modules/.bin/prisma validate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "packages/database/node_modules/.bin/prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "packages/database/node_modules/.bin/tsx packages/database/prisma/seed.ts",
    "db:seed:demo": "packages/database/node_modules/.bin/tsx packages/database/prisma/seed-demo.ts",
    "api:generate": "node scripts/generate-api-client.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^6.1.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
