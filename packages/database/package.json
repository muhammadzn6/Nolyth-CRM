{
  "name": "@orbit/database",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config ../../vitest.config.mts --passWithNoTests",
    "prisma": "prisma",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@orbit/config": "workspace:*",
    "@prisma/client": "^6.16.0",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.5"
  }
}
