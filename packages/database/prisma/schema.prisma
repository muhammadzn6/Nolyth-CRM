/// PostgreSQL enforces non-overlapping active exception intervals per BD with a GiST exclusion constraint.
model PerformanceLeaderboardException {
  id               String                               @id @default(uuid()) @db.Uuid
  bdId             String                               @map("bd_id") @db.Uuid
  type             PerformanceLeaderboardExceptionType
  reason           String
  effectiveFrom    DateTime                             @map("effective_from") @db.Timestamptz(6)
  expiresAt        DateTime                             @map("expires_at") @db.Timestamptz(6)
  createdById      String                               @map("created_by_id") @db.Uuid
  revokedAt        DateTime?                            @map("revoked_at") @db.Timestamptz(6)
  revokedById      String?                              @map("revoked_by_id") @db.Uuid
  revocationReason String?                              @map("revocation_reason")
  auditMetadata    Json?                                @map("audit_metadata")
  createdAt        DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int                                  @default(1)
  bd               User                                 @relation("PerformanceLeaderboardExceptionBd", fields: [bdId], references: [id], onDelete: Restrict)
  createdBy        User                                 @relation("PerformanceLeaderboardExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy        User?                                @relation("PerformanceLeaderboardExceptionRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([bdId, effectiveFrom, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("performance_leaderboard_exceptions")
}

