  actorNameSnapshot String?   @map("actor_name_snapshot")
  actorRoleSnapshot UserRole? @map("actor_role_snapshot")
  profileId         String?   @map("profile_id") @db.Uuid
  leadId            String?   @map("lead_id") @db.Uuid
  entityType        String    @map("entity_type")
  entityId          String    @map("entity_id") @db.Uuid
  action            String
  oldSnapshot       Json?     @map("old_snapshot")
  newSnapshot       Json?     @map("new_snapshot")
  metadata          Json?
  requestId         String?   @map("request_id")
  payload           Json?
  occurredAt        DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor             User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt])
  @@index([profileId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([requestId, occurredAt])
  @@map("activity_events")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id") @db.Uuid
  eventType      String       @map("event_type")
  idempotencyKey String       @unique @map("idempotency_key")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  lastError      String?      @map("last_error")
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  payload        Json
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}
