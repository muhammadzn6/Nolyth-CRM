generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserRole {
  ADMIN
  BD
  CLOSER
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  USER_INVITATION
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum CandidateStatus {
  ACTIVE
  ARCHIVED
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CompensationPeriod {
  HOURLY
  YEARLY
}

enum LeadStatus {
  APPLIED
  RESPONSE_RECEIVED
  INTERVIEWING
  OFFER_RECEIVED
  OFFER_ACCEPTED
  PLACED
  STARTED
  CLOSED
}

enum LeadContactRole {
  RECRUITER
  HR
  HIRING_MANAGER
  INTERVIEWER
}

enum CommunicationType {
  EMAIL
  PHONE
  LINKEDIN
  JOB_PLATFORM
  NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CollaborationVisibility {
  INTERNAL_TEAM
  SHARED_WITH_CLOSER
}
enum TaskStatus {
  OPEN
  COMPLETED
  CANCELED
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
enum TaskType {
  FOLLOW_UP
  PREPARE_INTERVIEW
  GENERAL
}
enum InterviewStatus {
  SCHEDULED
  RESCHEDULE_REQUIRED
  CANCELLED
  NO_SHOW
  COMPLETED
  WAITING_FEEDBACK
  PASSED
  FAILED
}
enum InterviewRoundType {
  PRE_SCREEN
  RECRUITER
  HR
  TECHNICAL
  CODING
  SYSTEM_DESIGN
  BEHAVIORAL
  HIRING_MANAGER
  FINAL
  OTHER
}
enum InterviewAttendance {
  ATTENDED
  MISSED
  UNKNOWN
}
enum DocumentType {
  CV
  COVER_LETTER
  SUPPORTING
  OTHER
}
enum DocumentUsageType {
  CV
  SUPPORTING
}
enum AvailabilityExceptionType {
  AVAILABLE_OVERRIDE
  UNAVAILABLE
  LEAVE
}
enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
}
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum CalendarProvider {
  GOOGLE
}

enum GoogleCalendarConnectionStatus {
  CONNECTED
  EXPIRED
  SYNCING
}

enum GoogleCalendarSyncStatus {
  SYNCED
  FAILED
  CANCELLED
}

enum DuplicateClassification {
  NONE
  LIKELY
  CONFIRMED
}

enum DuplicateReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PerformanceFollowUpStatus {
  OPEN
  COMPLETED
  NEEDS_REASSIGNMENT
  ADMIN_REASSIGNMENT_OVERDUE
}

enum PerformanceLeaderboardExceptionType {
  EXCLUDE
  PROVISIONAL
}

model User {
  id                     String                     @id @default(uuid()) @db.Uuid
  displayName            String                     @map("display_name")
  email                  String                     @unique @db.Citext
  passwordHash           String?                    @map("password_hash")
  timezone               String                     @default("UTC")
  lastLoginAt            DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt      DateTime?                  @map("password_changed_at") @db.Timestamptz(6)
  createdByUserId        String?                    @map("created_by_user_id") @db.Uuid
  role                   UserRole                   @default(BD)
  isActive               Boolean                    @default(true) @map("is_active")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                Int                        @default(1)
  createdByUser          User?                      @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdUsers           User[]                     @relation("UserCreatedBy")
  sessions               UserSession[]
  authTokens             AuthToken[]
  linkedCandidate        Candidate?                 @relation("CandidateLinkedUser")
  archivedCandidates     Candidate[]                @relation("CandidateArchivedBy")
  createdProfiles        Profile[]                  @relation("ProfileCreatedBy")
  archivedProfiles       Profile[]                  @relation("ProfileArchivedBy")
  bdAssignments          ProfileBdAssignment[]      @relation("ProfileBdAssignee")
  bdAssignmentsMade      ProfileBdAssignment[]      @relation("ProfileBdAssignedBy")
  closerEligibilities    ProfileCloserEligibility[] @relation("ProfileCloserEligibleUser")
  closerEligibilitySet   ProfileCloserEligibility[] @relation("ProfileCloserEligibilitySetBy")
  createdJobLeads        JobLead[]                  @relation("JobLeadCreatedBy")
  createdCompanies       Company[]                 @relation("CompanyCreatedBy")
  createdContacts        Contact[]                 @relation("ContactCreatedBy")
  ownedJobLeads          JobLead[]                  @relation("JobLeadCurrentOwner")
  responsibleJobLeads    JobLead[]                  @relation("JobLeadResponsibleCloser")
  archivedJobLeads       JobLead[]                  @relation("JobLeadArchivedBy")
  closedJobLeads         JobLead[]                  @relation("JobLeadClosedBy")
  ownershipTransfersFrom LeadOwnershipTransfer[]    @relation("LeadOwnershipTransferFrom")
  ownershipTransfersTo   LeadOwnershipTransfer[]    @relation("LeadOwnershipTransferTo")
  ownershipTransfersMade LeadOwnershipTransfer[]    @relation("LeadOwnershipTransferActor")
  closerAssignments      LeadCloserAssignment[]     @relation("LeadCloserAssignee")
  closerAssignmentsMade  LeadCloserAssignment[]     @relation("LeadCloserAssignedBy")
  statusTransitions      LeadStatusTransition[]     @relation("LeadStatusTransitionActor")
  activityEvents         ActivityEvent[]
  authoredCommunications Communication[] @relation("CommunicationAuthor")
  authoredComments       Comment[] @relation("CommentAuthor")
  assignedTasks          Task[] @relation("TaskAssignee")
  createdTasks           Task[] @relation("TaskCreator")
  createdInterviews      InterviewRound[] @relation("InterviewCreator")
  assignedInterviews     InterviewRound[] @relation("InterviewCloser")
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  createdOffers           Offer[] @relation("OfferCreator")
  notifications           Notification[]
  createdDocuments       Document[] @relation("DocumentCreator")
  uploadedDocumentVersions DocumentVersion[] @relation("DocumentUploader")
  attachedDocumentUsages LeadDocumentUsage[] @relation("DocumentUsageAttacher")
  googleCalendarConnections GoogleCalendarConnection[]
  clientCloserAssignments     CompanyCloserAssignment[] @relation("CompanyCloserAssignee")
  clientCloserAssignmentsMade CompanyCloserAssignment[] @relation("CompanyCloserAssignedBy")
  createdPerformanceRuleSets  PerformanceRuleSet[] @relation("PerformanceRuleSetCreatedBy")
  bdTargetSchedules           BdTargetSchedule[] @relation("BdTargetScheduleBd")
  createdBdTargetSchedules    BdTargetSchedule[] @relation("BdTargetScheduleCreatedBy")
  createdPerformanceHolidays  PerformanceHoliday[] @relation("PerformanceHolidayCreatedBy")
  performanceLeaves           PerformanceApprovedLeave[] @relation("PerformanceLeaveBd")
  approvedPerformanceLeaves   PerformanceApprovedLeave[] @relation("PerformanceLeaveApprovedBy")
  leaderboardExceptions       PerformanceLeaderboardException[] @relation("PerformanceLeaderboardExceptionBd")
  createdLeaderboardExceptions PerformanceLeaderboardException[] @relation("PerformanceLeaderboardExceptionCreatedBy")
  revokedLeaderboardExceptions PerformanceLeaderboardException[] @relation("PerformanceLeaderboardExceptionRevokedBy")
  createdDuplicateReviews     DuplicateReview[] @relation("DuplicateReviewCreatedBy")
  reviewedDuplicateReviews    DuplicateReview[] @relation("DuplicateReviewReviewer")
  ownedPerformanceFollowUps   PerformanceFollowUp[] @relation("PerformanceFollowUpOwner")
  originalPerformanceFollowUps PerformanceFollowUp[] @relation("PerformanceFollowUpOriginalOwner")
  reassignedPerformanceFollowUps PerformanceFollowUp[] @relation("PerformanceFollowUpReassignedBy")

  @@map("users")
}

model GoogleCalendarConnection {
  id                    String                         @id @default(uuid()) @db.Uuid
  userId                String                         @map("user_id") @db.Uuid
  companyId             String?                        @map("company_id") @db.Uuid
  profileId             String?                        @map("profile_id") @db.Uuid
  provider              CalendarProvider
  email                 String                         @map("account_email") @db.Citext
  calendarId            String                         @map("calendar_id")
  calendarName          String                         @map("calendar_name")
  encryptedRefreshToken String                         @map("encrypted_refresh_token")
  scopes                String[]                       @default([])
  lastSyncedAt          DateTime?                      @map("last_synced_at") @db.Timestamptz(6)
  status                GoogleCalendarConnectionStatus @default(CONNECTED)
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company               Company?                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile               Profile?                       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([companyId, provider])
  @@unique([profileId, provider])
  @@index([profileId, provider])
  @@map("google_calendar_connections")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int       @default(1)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  tokenHash  String           @unique @map("token_hash")
  purpose    AuthTokenPurpose
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([purpose, expiresAt])
  @@map("auth_tokens")
}

model Candidate {
  id            String          @id @default(uuid()) @db.Uuid
  linkedUserId  String?         @unique @map("linked_user_id") @db.Uuid
  archivedById  String?         @map("archived_by_id") @db.Uuid
  firstName     String          @map("first_name")
  lastName      String          @map("last_name")
  preferredName String?         @map("preferred_name")
  email         String?         @unique @db.Citext
  phone         String?
  timezone      String          @default("UTC")
  location      String?
  internalNotes String?         @map("internal_notes")
  status        CandidateStatus @default(ACTIVE)
  archivedAt    DateTime?       @map("archived_at") @db.Timestamptz(6)
  archiveReason String?         @map("archive_reason")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int             @default(1)
  linkedUser    User?           @relation("CandidateLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  archivedBy    User?           @relation("CandidateArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  profiles      Profile[]

  @@index([status, archivedAt])
  @@index([archivedById])
  @@map("candidates")
}

model Profile {
  id                   String                     @id @default(uuid()) @db.Uuid
  candidateId          String                     @map("candidate_id") @db.Uuid
  createdById          String                     @map("created_by_id") @db.Uuid
  archivedById         String?                    @map("archived_by_id") @db.Uuid
  name                 String
  description          String?
  status               ProfileStatus              @default(DRAFT)
  defaultCurrency      String                     @default("USD") @map("default_currency") @db.VarChar(3)
  targetCompensation   Decimal?                   @map("target_compensation") @db.Decimal(14, 2)
  compensationPeriod   CompensationPeriod?        @map("compensation_period")
  targetRoles          String[]                   @default([]) @map("target_roles")
  preferredLocations   String[]                   @default([]) @map("preferred_locations")
  workplacePreferences String[]                   @default([]) @map("workplace_preferences")
  jobTypePreferences   String[]                   @default([]) @map("job_type_preferences")
  contractPreferences  String[]                   @default([]) @map("contract_preferences")
  archivedAt           DateTime?                  @map("archived_at") @db.Timestamptz(6)
  archiveReason        String?                    @map("archive_reason")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int                        @default(1)
  candidate            Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  createdBy            User                       @relation("ProfileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedBy           User?                      @relation("ProfileArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  bdAssignments        ProfileBdAssignment[]
  closerEligibilities  ProfileCloserEligibility[]
  jobLeads             JobLead[]
  tasks                Task[]
  documents            Document[]
  googleCalendarConnections GoogleCalendarConnection[]

  @@index([candidateId, status])
  @@index([status, archivedAt])
  @@index([createdById])
  @@index([archivedById])
  @@map("profiles")
}

model ProfileBdAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  endedReason  String?   @map("ended_reason")
  assignedAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int       @default(1)
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user         User      @relation("ProfileBdAssignee", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User      @relation("ProfileBdAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([profileId, endedAt])
  @@index([userId])
  @@map("profile_bd_assignments")
}

model ProfileCloserEligibility {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  setById     String    @map("set_by_id") @db.Uuid
  isEligible  Boolean   @default(true) @map("is_eligible")
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)
  endedReason String?   @map("ended_reason")
  assignedAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int       @default(1)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user        User      @relation("ProfileCloserEligibleUser", fields: [userId], references: [id], onDelete: Restrict)
  setBy       User      @relation("ProfileCloserEligibilitySetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@index([profileId, endedAt])
  @@index([userId])
  @@map("profile_closer_eligibility")
}

model JobLead {
  id                   String                  @id @default(uuid()) @db.Uuid
  profileId            String                  @map("profile_id") @db.Uuid
  companyId            String                  @map("company_id") @db.Uuid
  sourceId             String                  @map("source_id") @db.Uuid
  createdById          String                  @map("created_by_id") @db.Uuid
  currentOwnerId       String                  @map("current_owner_id") @db.Uuid
  responsibleCloserId  String?                 @map("responsible_closer_id") @db.Uuid
  archivedById         String?                 @map("archived_by_id") @db.Uuid
  closedById           String?                 @map("closed_by_id") @db.Uuid
  companyName          String                  @map("company_name")
  jobTitle             String                  @map("job_title")
  description          String?
  rawUrl               String                  @map("raw_url")
  location             String?
  workplaceType        String?                 @map("workplace_type")
  employmentType       String?                 @map("employment_type")
  contractType         String?                 @map("contract_type")
  compensationMin      Decimal?                @map("compensation_min") @db.Decimal(14, 2)
  compensationMax      Decimal?                @map("compensation_max") @db.Decimal(14, 2)
  compensationPeriod   CompensationPeriod?     @map("compensation_period")
  appliedDate          DateTime                @map("applied_date") @db.Date
  isImportant          Boolean                 @default(false) @map("is_important")
  source               String                  @default("manual")
  canonicalUrl         String?                 @map("canonical_url")
  canonicalHash        String?                 @map("canonical_hash")
  duplicateClassification DuplicateClassification @default(NONE) @map("duplicate_classification")
  qualifiedCredit      Boolean                 @default(true) @map("qualified_credit")
  status               LeadStatus              @default(APPLIED)
  archiveReason        String?                 @map("archive_reason")
  archivedAt           DateTime?               @map("archived_at") @db.Timestamptz(6)
  closureReason        String?                 @map("closure_reason")
  closureNotes         String?                 @map("closure_notes")
  closedAt             DateTime?               @map("closed_at") @db.Timestamptz(6)
  placedAt             DateTime?               @map("placed_at") @db.Timestamptz(6)
  startDate            DateTime?               @map("start_date") @db.Date
  startedAt            DateTime?               @map("started_at") @db.Timestamptz(6)
  compensationAmount   Decimal?                @map("compensation_amount") @db.Decimal(14, 2)
  compensationCurrency String?                 @map("compensation_currency") @db.VarChar(3)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int                     @default(1)
  profile              Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceRef            JobSource               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdBy            User                    @relation("JobLeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  currentOwner         User                    @relation("JobLeadCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: Restrict)
  responsibleCloser    User?                   @relation("JobLeadResponsibleCloser", fields: [responsibleCloserId], references: [id], onDelete: Restrict)
  archivedBy           User?                   @relation("JobLeadArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  closedBy             User?                   @relation("JobLeadClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  ownershipTransfers   LeadOwnershipTransfer[]
  closerAssignments    LeadCloserAssignment[]
  statusTransitions    LeadStatusTransition[]
  contacts             LeadContact[]
  communications       Communication[]
  comments             Comment[]
  tasks                Task[]
  interviews           InterviewRound[]
  documentUsages       LeadDocumentUsage[]
  offers               Offer[]
  duplicateReview      DuplicateReview?
  performanceFollowUp  PerformanceFollowUp?

  @@index([profileId, status])
  @@index([profileId, status, appliedDate])
  @@index([profileId, isImportant, appliedDate])
  @@index([profileId, canonicalHash])
  @@index([duplicateClassification, qualifiedCredit])
  @@index([currentOwnerId, appliedDate])
  @@index([currentOwnerId])
  @@index([responsibleCloserId])
  @@index([companyId])
  @@index([sourceId])
  @@map("job_leads")
}

model PerformanceRuleSet {
  id                                String                  @id @default(uuid()) @db.Uuid
  effectiveFrom                     DateTime                @map("effective_from") @db.Timestamptz(6)
  effectiveTo                       DateTime?               @map("effective_to") @db.Timestamptz(6)
  defaultDailyTarget                Int                     @default(70) @map("default_daily_target")
  businessCalendarTimeZone          String                  @default("America/New_York") @map("business_calendar_time_zone") @db.VarChar(64)
  workdayStartHour                  Int                     @default(9) @map("workday_start_hour")
  workdayEndHour                    Int                     @default(17) @map("workday_end_hour")
  followUpSlaBusinessHours          Int                     @default(48) @map("follow_up_sla_business_hours")
  adminReassignmentSlaBusinessHours Int                     @default(2) @map("admin_reassignment_sla_business_hours")
  maturityWindowDays                Int                     @default(21) @map("maturity_window_days")
  duplicateLookbackMonths           Int                     @default(6) @map("duplicate_lookback_months")
  applicationWeightPercent          Decimal                 @default(45) @map("application_weight_percent") @db.Decimal(5, 2)
  followUpWeightPercent             Decimal                 @default(25) @map("follow_up_weight_percent") @db.Decimal(5, 2)
  outcomeWeightPercent              Decimal                 @default(30) @map("outcome_weight_percent") @db.Decimal(5, 2)
  positiveReplyPoints               Int                     @default(1) @map("positive_reply_points")
  screeningPoints                   Int                     @default(2) @map("screening_points")
  interviewPoints                   Int                     @default(3) @map("interview_points")
  offerPoints                       Int                     @default(5) @map("offer_points")
  slowdownThresholdPercent          Decimal                 @default(120) @map("slowdown_threshold_percent") @db.Decimal(6, 2)
  slowdownMultiplierPercent         Decimal                 @default(25) @map("slowdown_multiplier_percent") @db.Decimal(5, 2)
  createdById                       String                  @map("created_by_id") @db.Uuid
  auditMetadata                     Json?                   @map("audit_metadata")
  workingDays                       Int[]                   @default([1, 2, 3, 4, 5]) @map("working_days")
  createdAt                         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                           Int                     @default(1)
  createdBy                         User                    @relation("PerformanceRuleSetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([effectiveFrom, effectiveTo])
  @@index([createdById, createdAt])
  @@map("performance_rule_sets")
}

model BdTargetSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  bdId          String    @map("bd_id") @db.Uuid
  dailyTarget   Int       @default(70) @map("daily_target")
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdById   String    @map("created_by_id") @db.Uuid
  auditMetadata Json?     @map("audit_metadata")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int       @default(1)
  bd            User      @relation("BdTargetScheduleBd", fields: [bdId], references: [id], onDelete: Restrict)
  createdBy     User      @relation("BdTargetScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([bdId, effectiveFrom, effectiveTo])
  @@index([effectiveFrom, effectiveTo])
  @@map("bd_target_schedules")
}

model PerformanceHoliday {
  id            String   @id @default(uuid()) @db.Uuid
  holidayDate   DateTime @map("holiday_date") @db.Date
  name          String
  createdById   String   @map("created_by_id") @db.Uuid
  auditMetadata Json?    @map("audit_metadata")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  createdBy     User     @relation("PerformanceHolidayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([holidayDate])
  @@index([createdById, holidayDate])
  @@map("performance_holidays")
}

/// PostgreSQL enforces non-overlapping leave intervals per BD with a GiST exclusion constraint.
model PerformanceApprovedLeave {
  id            String   @id @default(uuid()) @db.Uuid
  bdId          String   @map("bd_id") @db.Uuid
  startsAt      DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(6)
  availableStartHour Int? @map("available_start_hour")
  availableEndHour   Int? @map("available_end_hour")
  reason        String?
  approvedById  String   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime @default(now()) @map("approved_at") @db.Timestamptz(6)
  auditMetadata Json?    @map("audit_metadata")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  bd            User     @relation("PerformanceLeaveBd", fields: [bdId], references: [id], onDelete: Restrict)
  approvedBy    User     @relation("PerformanceLeaveApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([bdId, startsAt, endsAt])
  @@index([startsAt, endsAt])
