{
  "name": "@orbit/testing",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config ../../vitest.config.mts --passWithNoTests"
  },
  "dependencies": {
    "@orbit/config": "workspace:*",
    "@orbit/contracts": "workspace:*",
    "@orbit/database": "workspace:*",
    "@orbit/backend": "workspace:*",
    "@orbit/ui": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.35.0"
  }
}
